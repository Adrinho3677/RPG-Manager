# Copie para .env e ajuste. Gere a chave com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao

# 1 em produção com HTTPS (PythonAnywhere). Deixe 0 em http://localhost.
SECURE_COOKIES=0

# Fuso para mostrar horários (o banco guarda em UTC).
TIMEZONE=America/Sao_Paulo

# Opcional. Sem isto, usa SQLite em instance/rpgmanager.db
# DATABASE_URL=mysql+pymysql://usuario:senha@usuario.mysql.pythonanywhere-services.com/usuario$rpg
